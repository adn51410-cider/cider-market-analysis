# Database (Neon PostgreSQL)
# 取得方法: https://neon.tech でプロジェクト作成後、接続文字列をコピー
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# e-Stat API
# 取得方法: https://www.e-stat.go.jp/api/ でユーザ登録後、アプリケーションIDを発行
ESTAT_API_KEY=your_estat_api_key_here

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3247
